PGHOST=your-postgresql-host
PGPORT=5432
PGUSER=your-postgresql-user
PGPASSWORD=replace-with-your-password
PGDATABASE=your-postgresql-database
PGSCHEMA=ghatcpt
# verify-full enables verified TLS. Set disable only for a server without TLS.
PGSSLMODE=verify-full
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
